# ==============================================================================
# EGAT VMS (Vehicle Management System) - Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND (Render Web Service)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# Database Connection (Neon PostgreSQL - Recommended)
# Found in: Neon Dashboard -> Connection Details -> Connection String
DATABASE_URL="postgresql://neondb_owner:your_password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Optional Pooled Connection:
DATABASE_URL_POOLED="postgresql://neondb_owner:your_password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Alternative: Supabase Connection
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ------------------------------------------------------------------------------
# 2. FRONTEND (Vercel)
# ------------------------------------------------------------------------------
# Point this to your live Render backend URL (without trailing slash)
# e.g. https://vms-backend.onrender.com
VITE_API_URL=https://your-backend-name.onrender.com
