# ==============================================================================
# EGAT VMS (Vehicle Management System) - Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND (Render Web Service)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# Supabase Connection (Required for Cloud Database)
# Found in: Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
# OR:
SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. FRONTEND (Vercel)
# ------------------------------------------------------------------------------
# Point this to your live Render backend URL (without trailing slash)
# e.g. https://vms-backend.onrender.com
VITE_API_URL=https://your-backend-name.onrender.com
